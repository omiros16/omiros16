<?xml version="1.0" encoding="utf-8"?>
<!-- The Gmail app password never leaves the phone in a backup or a transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="secret.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="secret.xml" />
    </device-transfer>
</data-extraction-rules>
