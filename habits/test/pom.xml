<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.omiros</groupId><artifactId>habits-tests</artifactId><version>1</version>
  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>
  <dependencies>
    <dependency><groupId>org.robolectric</groupId><artifactId>robolectric</artifactId><version>4.16.1</version><scope>test</scope>
      <exclusions><exclusion><groupId>androidx.test</groupId><artifactId>*</artifactId></exclusion><exclusion><groupId>androidx.test.espresso</groupId><artifactId>*</artifactId></exclusion></exclusions></dependency>
    <dependency><groupId>local</groupId><artifactId>android-all</artifactId><version>14</version><scope>system</scope><systemPath>${project.basedir}/../../.tools/android-all.jar</systemPath></dependency>
    <dependency><groupId>local</groupId><artifactId>habits</artifactId><version>1</version><scope>system</scope><systemPath>${project.basedir}/app.jar</systemPath></dependency>
    <dependency><groupId>junit</groupId><artifactId>junit</artifactId><version>4.13.2</version><scope>test</scope></dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>3.2.5</version>
        <configuration>
          <additionalClasspathElements><additionalClasspathElement>${project.basedir}/../../.tools/android-all.jar</additionalClasspathElement></additionalClasspathElements>
          <redirectTestOutputToFile>false</redirectTestOutputToFile>
          <trimStackTrace>false</trimStackTrace>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
